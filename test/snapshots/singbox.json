{
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "detour": "Proxy"
      },
      {
        "type": "https",
        "tag": "dns-direct",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "reject"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "ai",
          "proxy"
        ],
        "action": "route",
        "server": "dns-remote"
      }
    ],
    "final": "dns-direct",
    "strategy": "ipv4_only"
  },
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "tag": "ai",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/ai.srs"
      },
      {
        "type": "remote",
        "tag": "ai-ip",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/ai-ip.srs"
      },
      {
        "type": "remote",
        "tag": "private",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/private.srs"
      },
      {
        "type": "remote",
        "tag": "reject",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/reject.srs"
      },
      {
        "type": "remote",
        "tag": "icloud",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/icloud.srs"
      },
      {
        "type": "remote",
        "tag": "apple",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/apple.srs"
      },
      {
        "type": "remote",
        "tag": "proxy",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/proxy.srs"
      },
      {
        "type": "remote",
        "tag": "direct",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/direct.srs"
      },
      {
        "type": "remote",
        "tag": "telegramcidr",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/telegramcidr.srs"
      },
      {
        "type": "remote",
        "tag": "cncidr",
        "format": "binary",
        "url": "https://example.test/rule-set/singbox/cncidr.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "rule_set": "ai",
        "action": "route",
        "outbound": "AI"
      },
      {
        "rule_set": "ai-ip",
        "action": "route",
        "outbound": "AI"
      },
      {
        "rule_set": "private",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "reject",
        "action": "reject"
      },
      {
        "rule_set": "icloud",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "apple",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "proxy",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "telegramcidr",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "cncidr",
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": "cncidr",
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "Proxy",
    "default_domain_resolver": "dns-direct"
  }
}
